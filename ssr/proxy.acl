^.*aistudio\.google\.com$
^.*aiplatform\.googleapis\.com$
^.*gemini\.google\.com$
^.*cloudcode-pa\.googleapis\.com$
^.*daily-cloudcode-pa\.googleapis\.com$
^.*aisandbox-pa\.googleapis\.com$
^.*antigravity\.google$
^.*antigravity\.com$
^.*antigravity-unleash\.goog$
^.*tokenharbor\.ai$
^.*accounts\.google\.com$
^.*oauth2\.googleapis\.com$
^.*www\.googleapis\.com$
^.*play\.googleapis\.com$
^.*mistral\.ai$
^.*codestral\.mistral\.ai$
^.*x\.ai$
^.*space-x\.ai$
^.*githubcopilot\.com$
^.*copilot\.githubusercontent\.com$
^.*copilot\.microsoft\.com$
^.*cursor\.sh$
^.*cursorapi\.com$
^.*perplexity\.ai$
^.*groq\.com$
^.*together\.xyz$
^.*fireworks\.ai$
^.*cerebras\.ai$
^.*replicate\.com$
^.*cohere\.com$
^.*voyageai\.com$
^.*openrouter\.ai$
^.*huggingface\.co$
^.*router\.huggingface\.co$
^.*poe\.com$

[bypass_list]
# Domestic AI
^.*deepseek\.com$
^.*dashscope\.aliyuncs\.com$
^.*dashscope\.aliyun\.com$
